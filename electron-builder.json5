{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "co.netagro.colombia",
  "productName": "NetAgro Colombia",
  "asar": true,
  "npmRebuild": false,
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!node_modules/**/*",
    "!**/.env*"
  ],
  "extraResources": [
    {
      "from": "data/processed",
      "to": "data",
      "filter": [
        "coverage.json",
        "departments.geojson",
        "municipalities.geojson",
        "centers.geojson",
        "rankings.json",
        "metadata.json",
        "manifest.json"
      ]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "NetAgro-Colombia-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NetAgro Colombia"
  }
}
