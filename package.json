{
  "name": "netagro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:build": "tsx scripts/data/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "package": "pnpm build && pnpm data:verify && electron-builder --win",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/run-electron-smoke.cjs",
    "preview": "vite preview",
    "data:verify": "node scripts/verify-data.cjs",
    "test:packaged": "node scripts/smoke-packaged.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@turf/turf": "^7.4.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.2.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/shapefile": "^0.6.4",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "csv-parse": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.33",
    "shapefile": "^0.6.6",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^6.4.6",
    "vite-plugin-electron": "^0.28.6",
    "vitest": "^4.1.12"
  },
  "main": "dist-electron/main.js",
  "description": "Offline mobile coverage analysis for Colombia using CRC and DANE data",
  "author": "NetAgro"
}
